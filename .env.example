# Copy to .env and adjust. Every variable is optional; defaults are shown. Keys stay out of the repository.

# ---------------------------------------------------------------------------------------------------------
# Upstream LLM (where redacted requests go)
# ---------------------------------------------------------------------------------------------------------
# fake (offline echo bot, default) | openrouter | openai | anthropic
PII_SHIELD_UPSTREAM_PROVIDER=fake
# Model used when the client sends none or "auto". Empty = provider default
# (openrouter: nvidia/nemotron-3-super-120b-a12b:free, openai: gpt-5-mini, anthropic: claude-sonnet-5).
PII_SHIELD_UPSTREAM_MODEL=
# OpenRouter fallback list (comma-separated), sent as `models` so OpenRouter can switch when one is overloaded.
PII_SHIELD_UPSTREAM_FALLBACK_MODELS=
# Refuse any OpenRouter model id that does not end in ":free" (also checks the model that actually answered).
PII_SHIELD_REQUIRE_FREE_MODELS=true
PII_SHIELD_UPSTREAM_TIMEOUT_SECONDS=120
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenAI-compatible server works too (vLLM, LiteLLM, Azure OpenAI proxy).
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------------------------------------
# Policies and tenants
# ---------------------------------------------------------------------------------------------------------
# Directory of policy YAML files (default: the packaged ones in src/pii_shield/policies).
# PII_SHIELD_POLICIES_DIR=
PII_SHIELD_DEFAULT_POLICY=support-chat
# Let clients pick a policy with the X-PII-Policy header (tenants can still be restricted).
PII_SHIELD_ALLOW_POLICY_HEADER=true
# Add a short system message telling the model to keep placeholders verbatim (only when placeholders were sent).
PII_SHIELD_PLACEHOLDER_HINT=true
# YAML file mapping gateway API keys (SHA-256) to tenants and policies. Unset = open gateway (development).
# PII_SHIELD_TENANTS_FILE=configs/tenants.example.yaml

# ---------------------------------------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------------------------------------
PII_SHIELD_NER_ENABLED=true
PII_SHIELD_NER_MODEL=knowledgator/gliner-pii-base-v1.0
PII_SHIELD_NER_THREADS=4
PII_SHIELD_NER_PRELOAD=true
# Optional LLM detector (used by policies with `detectors: {llm: true}`). Point it at a model you trust with
# the residual text: it sees the text after patterns and NER have masked what they found.
PII_SHIELD_LLM_DETECTOR_PROVIDER=openrouter
PII_SHIELD_LLM_DETECTOR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PII_SHIELD_LLM_DETECTOR_FALLBACK_MODELS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free

# ---------------------------------------------------------------------------------------------------------
# Session vault (placeholder <-> original, AES-256-GCM encrypted, expires after the TTL)
# ---------------------------------------------------------------------------------------------------------
# memory (single process) | redis (several replicas) | file (CLI)
PII_SHIELD_VAULT_BACKEND=memory
PII_SHIELD_REDIS_URL=redis://localhost:6379/0
PII_SHIELD_VAULT_DIR=.cache/vault
# URL-safe base64 32-byte key: `pii-shield keygen`. Unset = random per process (sessions end on restart).
# PII_SHIELD_VAULT_KEY=
PII_SHIELD_VAULT_TTL_SECONDS=3600
# Secret for the `hash` action and synthetic seeds. Unset = derived from the vault key.
# PII_SHIELD_HASH_KEY=

# ---------------------------------------------------------------------------------------------------------
# Audit log and dashboard
# ---------------------------------------------------------------------------------------------------------
# JSONL file for audit records (counts, types, hashes; never values). Unset = in memory only.
# PII_SHIELD_AUDIT_FILE=audit.jsonl
PII_SHIELD_AUDIT_MAX_ENTRIES=2000
PII_SHIELD_RESULTS_DIR=results

# ---------------------------------------------------------------------------------------------------------
# Budget for real API calls (evaluation, LLM detector, playground "real model")
# ---------------------------------------------------------------------------------------------------------
PII_SHIELD_LLM_CACHE_DIR=.cache/llm
PII_SHIELD_LLM_LEDGER=results/calls.jsonl
PII_SHIELD_LLM_MAX_CALLS=300
PII_SHIELD_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3.0
PII_SHIELD_LLM_MAX_RETRIES=4

LOG_LEVEL=INFO
# console (human-readable) or json (one JSON object per line)
LOG_FORMAT=console
